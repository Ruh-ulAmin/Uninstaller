<Window x:Class="Uninstaller.App.Views.ForceRemoveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Force Remove" Height="480" Width="640" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"
                   TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="These items were found on disk / in the registry for this program. Review the list, uncheck anything you want to keep, then remove the rest. This cannot be undone." />

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <ListView x:Name="ItemsList" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="34">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Type" Width="90" DisplayMemberBinding="{Binding KindDisplay}" />
                        <GridViewColumn Header="Location" Width="330" DisplayMemberBinding="{Binding Item.Path}" />
                        <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding Item.SizeDisplay}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="100" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button Content="Remove Selected" Width="140" Style="{StaticResource DangerButton}"
                    Click="RemoveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
