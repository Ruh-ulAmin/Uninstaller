<Window x:Class="Uninstaller.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Uninstaller" Height="320" Width="420" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Image Source="/Resources/app.ico" Width="48" Height="48" Margin="0,0,14,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Uninstaller" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="A modern, full-featured uninstaller for Windows. Lists every installed Win32 application and Store app, uninstalls them the same way Windows itself would, and can clean up leftover files, folders, shortcuts and registry entries that a program's own uninstaller left behind." />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Run as administrator for full functionality, since removing machine-wide programs and their leftovers requires elevated permissions." />
        </StackPanel>

        <Button Grid.Row="2" Content="Close" Width="100" HorizontalAlignment="Right" Style="{StaticResource AccentButton}"
                Click="CloseButton_Click" />
    </Grid>
</Window>
