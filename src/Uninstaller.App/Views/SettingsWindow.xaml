<Window x:Class="Uninstaller.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options" Height="380" Width="440" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Options" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />

        <StackPanel Grid.Row="1">
            <CheckBox x:Name="ShowSystemComponentsCheck" Content="Show system components" Margin="0,0,0,10" />
            <CheckBox x:Name="ShowWindowsUpdatesCheck" Content="Show Windows updates" Margin="0,0,0,10" />
            <CheckBox x:Name="ConfirmBeforeUninstallCheck" Content="Confirm before uninstalling" Margin="0,0,0,10" />
            <CheckBox x:Name="PreferSilentUninstallCheck"
                      Content="Prefer silent uninstall when a program supports it" Margin="0,0,0,20" />

            <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,8" />
            <RadioButton x:Name="ThemeSystemRadio" Content="Use system setting" GroupName="Theme" Margin="0,0,0,6" />
            <RadioButton x:Name="ThemeLightRadio" Content="Light" GroupName="Theme" Margin="0,0,0,6" />
            <RadioButton x:Name="ThemeDarkRadio" Content="Dark" GroupName="Theme" Margin="0,0,0,6" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="100" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button Content="Save" Width="100" Style="{StaticResource AccentButton}" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
