<Window x:Class="Uninstaller.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Uninstaller.App.Converters"
        Title="Uninstaller" Height="720" Width="1180" MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Top menu bar ===================== -->
        <Menu Grid.Row="0" x:Name="TopMenu">
            <MenuItem Header="_File">
                <MenuItem Header="_Refresh" InputGestureText="Ctrl+R" Click="RefreshMenuItem_Click" />
                <MenuItem Header="_Export Program List..." InputGestureText="Ctrl+E" Click="ExportMenuItem_Click" />
                <MenuItem Header="Open _Log Folder" Click="OpenLogFolderMenuItem_Click" />
                <Separator />
                <MenuItem Header="Restart as _Administrator" Click="RestartAsAdminButton_Click"
                          Visibility="{Binding IsAdministrator, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="ExitMenuItem_Click" />
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Click="SelectAllMenuItem_Click" />
                <MenuItem Header="Select _None" Click="SelectNoneMenuItem_Click" />
                <MenuItem Header="_Invert Selection" Click="InvertSelectionMenuItem_Click" />
                <Separator />
                <MenuItem Header="_Find..." InputGestureText="Ctrl+F" Click="FindMenuItem_Click" />
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="Show System _Components" IsCheckable="True"
                          IsChecked="{Binding ShowSystemComponents}" />
                <MenuItem Header="Show Windows _Updates" IsCheckable="True"
                          IsChecked="{Binding ShowWindowsUpdates}" />
                <Separator />
                <MenuItem Header="_Theme">
                    <MenuItem Header="_Light" Click="ThemeLight_Click" />
                    <MenuItem Header="_Dark" Click="ThemeDark_Click" />
                    <MenuItem Header="Use _System Setting" Click="ThemeSystem_Click" />
                </MenuItem>
                <Separator />
                <MenuItem Header="_Refresh" Click="RefreshMenuItem_Click" />
            </MenuItem>

            <MenuItem Header="_Actions">
                <MenuItem Header="_Uninstall..." InputGestureText="Del" Click="UninstallMenuItem_Click" />
                <MenuItem Header="Uninstall _Silently" Click="UninstallSilentMenuItem_Click" />
                <MenuItem Header="Uninstall _Checked Items..." Click="UninstallCheckedMenuItem_Click" />
                <MenuItem Header="_Modify" Click="ModifyMenuItem_Click" />
                <Separator />
                <MenuItem Header="_Force Remove / Clean Leftovers..." Click="ForceRemoveMenuItem_Click" />
                <Separator />
                <MenuItem Header="Open _Install Location" Click="OpenInstallLocationMenuItem_Click" />
                <MenuItem Header="Open _Registry Key" Click="OpenRegistryKeyMenuItem_Click" />
                <MenuItem Header="_Copy Uninstall Command" Click="CopyUninstallCommandMenuItem_Click" />
            </MenuItem>

            <MenuItem Header="_Tools">
                <MenuItem Header="_Leftover Scanner..." Click="LeftoverScannerMenuItem_Click" />
                <MenuItem Header="_Options..." Click="OptionsMenuItem_Click" />
                <Separator />
                <MenuItem Header="View _Log File" Click="OpenLogFolderMenuItem_Click" />
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="_Check for Updates" Click="CheckForUpdatesMenuItem_Click" />
                <MenuItem Header="_About Uninstaller" Click="AboutMenuItem_Click" />
            </MenuItem>
        </Menu>

        <!-- ===================== Toolbar ===================== -->
        <ToolBarTray Grid.Row="1">
            <ToolBar>
                <Button Style="{StaticResource ToolBarIconButton}" Click="RefreshMenuItem_Click" ToolTip="Refresh (Ctrl+R)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Separator />
                <Button Style="{StaticResource AccentButton}" Click="UninstallMenuItem_Click" ToolTip="Uninstall the selected program">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" />
                        <TextBlock Text="Uninstall" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DangerButton}" Margin="6,0,0,0" Click="ForceRemoveMenuItem_Click"
                        ToolTip="Force remove leftovers for the selected program">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" />
                        <TextBlock Text="Force Remove" />
                    </StackPanel>
                </Button>
                <Separator />
                <Button Style="{StaticResource ToolBarIconButton}" Click="LeftoverScannerMenuItem_Click" ToolTip="Scan for leftover files and registry entries">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" />
                        <TextBlock Text="Leftover Scanner" />
                    </StackPanel>
                </Button>
                <Separator />
                <Border Width="260" Height="30" CornerRadius="4" Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1" Margin="4,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,4,0" VerticalAlignment="Center" />
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Search installed programs..." IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding SearchText, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                        </Grid>
                    </Grid>
                </Border>
            </ToolBar>
        </ToolBarTray>

        <!-- ===================== Elevation notice bar ===================== -->
        <Border Grid.Row="2" Background="{DynamicResource WarningBackgroundBrush}"
                BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="0,0,0,1" Padding="12,6"
                Visibility="{Binding IsAdministrator, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap"
                           VerticalAlignment="Center">
                    <Run Text="&#x26A0; Not running as administrator." FontWeight="SemiBold" />
                    <Run Text=" That's expected and safe for most programs - you'll only be prompted for elevation when a specific action needs it (e.g. removing a machine-wide program)." />
                </TextBlock>
                <Button Grid.Column="1" Content="Restart as Administrator" Margin="12,0,0,0"
                        Click="RestartAsAdminButton_Click" />
            </Grid>
        </Border>

        <!-- ===================== Main content ===================== -->
        <Grid Grid.Row="3" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <DataGrid x:Name="ProgramsGrid" ItemsSource="{Binding ProgramsView}"
                          SelectedItem="{Binding SelectedProgram}"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          IsReadOnly="True" BorderThickness="0"
                          MouseDoubleClick="ProgramsGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="34" CanUserResize="False" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Name" Width="3*" SortMemberPath="DisplayName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="2*" />
                        <DataGridTextColumn Header="Version" Binding="{Binding DisplayVersion}" Width="120" />
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="90" />
                        <DataGridTextColumn Header="Installed" Binding="{Binding InstallDateDisplay}" Width="100" />
                        <DataGridTextColumn Header="Type" Binding="{Binding ArchitectureDisplay}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- ===================== Details pane ===================== -->
            <Border Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                <Grid>
                    <TextBlock Text="Select a program to see details."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                               Visibility="{Binding SelectedProgram, Converter={StaticResource InverseNullToVisibilityConverter}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedProgram, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel DataContext="{Binding SelectedProgram}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Image Source="{Binding Icon}" Width="40" Height="40" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold"
                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Publisher" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                <TextBlock Text="{Binding Publisher}" Margin="0,0,0,10" TextWrapping="Wrap" />

                                <TextBlock Text="Version" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                <TextBlock Text="{Binding DisplayVersion}" Margin="0,0,0,10" />

                                <TextBlock Text="Size" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                <TextBlock Text="{Binding SizeDisplay}" Margin="0,0,0,10" />

                                <TextBlock Text="Installed on" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                <TextBlock Text="{Binding InstallDateDisplay}" Margin="0,0,0,10" />

                                <TextBlock Text="Install location" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                <TextBlock Text="{Binding Program.InstallLocation}" Margin="0,0,0,10" TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Style="{StaticResource AccentButton}" Content="Uninstall..." Margin="0,0,0,8"
                                    Click="UninstallMenuItem_Click" />
                            <Button Content="Modify" Margin="0,0,0,8" Click="ModifyMenuItem_Click"
                                    Visibility="{Binding HasModify, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Open Install Location" Margin="0,0,0,8" Click="OpenInstallLocationMenuItem_Click" />
                            <Button Content="Open Registry Key" Margin="0,0,0,8" Click="OpenRegistryKeyMenuItem_Click"
                                    Visibility="{Binding IsStoreApp, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            <Button Style="{StaticResource DangerButton}" Content="Force Remove / Clean Leftovers..."
                                    Click="ForceRemoveMenuItem_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== Status bar ===================== -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock>
                    <Run Text="{Binding VisibleProgramCount, Mode=OneWay}" />
                    <Run Text=" of " />
                    <Run Text="{Binding TotalProgramCount, Mode=OneWay}" />
                    <Run Text=" programs" />
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock>
                    <Run Text="{Binding IsAdministrator, Mode=OneWay, StringFormat='Administrator: {0}'}" />
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
